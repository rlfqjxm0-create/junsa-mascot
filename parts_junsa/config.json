  "game_talk": [
    "어… 끝났네.",
    "방금 뭔가 잘한 것 같아.",
    "타일이 다 어디 갔지.",
    "잘했어. 진짜로.",
    "생각을 잠깐 껐는데 끝나 있었어.",
    "아, 지금 그거 좋았어.",
    "음. 나쁘지 않아."
  ],
  "game_talk_win": [
    "다 지웠어… 진짜네?",
    "하나도 안 남았어. 신기하다.",
    "이건 좀 대단한데."
  ],
  "g2_talk": {
    "start": [
